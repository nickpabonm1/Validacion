// GENERADO AUTOMÁTICAMENTE por scripts/build-postgresql-schema.mjs a partir de schema.prisma — no editar a mano.
// Variante para despliegues en PostgreSQL (ver la pestaña "Base de datos" del menú, o docs/architecture.md §6).

// FAD Biometrics Configuration & Results Console — modelo de datos
// SQLite por defecto (desarrollo/demo). El conector SQLite de Prisma no soporta `enum` ni el
// tipo nativo `Json`: los enums se modelan como `String` (validados en la capa de aplicación
// con los enums de @fad-console/shared-types) y los campos JSON se guardan como `String`
// serializado (ver apps/backend/src/lib/json-field.ts para el helper de (de)serialización).
// Para desplegar en PostgreSQL, ver `prisma/postgresql/schema.prisma` (generado desde este
// archivo por `scripts/build-postgresql-schema.mjs`) y docs/architecture.md §6 — no editar ese
// archivo a mano, ni los modelos de abajo pensando solo en SQLite: deben seguir sirviendo a
// ambos motores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  /// UserRole: ADMIN | OPERATOR | AUDITOR | LAUNCHER
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// `null` = usuario de plataforma (acceso global, comportamiento histórico previo a la
  /// jerarquía de clientes). Con un cliente asignado, el usuario queda confinado a ese cliente y
  /// a sus hijos (ver clients/client-scope.ts) — nunca ve ni administra otros clientes.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  createdTemplates       ValidationTemplate[]  @relation("TemplateCreatedBy")
  updatedTemplates       ValidationTemplate[]  @relation("TemplateUpdatedBy")
  createdWebSdkTemplates WebSdkTemplate[]      @relation("WebSdkTemplateCreatedBy")
  updatedWebSdkTemplates WebSdkTemplate[]      @relation("WebSdkTemplateUpdatedBy")
  executions             ValidationExecution[] @relation("ExecutionCreatedBy")
  auditLogs              AuditLog[]
  updatedSettings        SystemSetting[]
  shareLinks             WebSdkShareLink[]     @relation("ShareLinkCreatedBy")
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

/// Token de un solo uso para "Olvidé mi contraseña" (correo). Solo se guarda el hash SHA-256 del
/// token (nunca el valor enviado por correo) — igual criterio que las credenciales cifradas: el
/// valor real solo existe en el enlace que recibe el usuario. `usedAt` lo invalida tras usarse una
/// vez; `expiresAt` lo invalida por tiempo aunque nadie lo use.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Jerarquía de clientes (multi-tenant): un cliente puede tener clientes "hijos"
/// (`parentClientId`), cada uno con sus propios usuarios (login) y ambientes/credenciales FAD,
/// aislados del resto — un usuario con `clientId` asignado solo ve su propio cliente y su
/// subárbol de hijos (ver `getClientSubtreeIds` en clients/client-scope.ts). Un usuario de
/// plataforma (`clientId: null`) sigue viendo todo, igual que antes de esta jerarquía. El logo/
/// color/favicon son la personalización de marca ("white-label") que un cliente ve al entrar, y
/// que también puede definir para sus propios hijos.
model Client {
  id             String   @id @default(uuid())
  name           String
  parentClientId String?
  parentClient   Client?  @relation("ClientHierarchy", fields: [parentClientId], references: [id], onDelete: Cascade)
  children       Client[] @relation("ClientHierarchy")

  /// Data URL (base64) — igual patrón que NormalizedMediaAsset.dataUrl, sin infraestructura de
  /// archivos aparte.
  logoDataUrl    String?
  faviconDataUrl String?
  /// Color hex (p. ej. "#1d4ed8") aplicado como acento de marca en la interfaz del cliente.
  primaryColor   String?

  /// Plantilla del correo que se envía al iniciar un proceso de validación (asunto + cuerpo
  /// HTML), con placeholders `{{processName}}`, `{{environmentName}}`, `{{clientName}}`,
  /// `{{link}}`, `{{logo}}` (ver messaging/email-template.ts). `null` = hereda la del cliente
  /// padre más cercano que sí tenga una, y si ninguno la define, se usa la plantilla por
  /// defecto de la consola — igual patrón de herencia que logo/color/favicon.
  emailSubjectTemplate String?
  emailBodyTemplate    String?

  /// Conexión a una base de datos EXTERNA propia del cliente (MongoDB o Neo4j) — a diferencia
  /// del resto de este esquema, esto NO usa Prisma para hablar con esa base: se conecta con el
  /// driver oficial de cada motor (`mongodb`/`neo4j-driver`) directamente desde
  /// `client-database-connection.service.ts`, así que sí hay soporte funcional real (probar
  /// conexión de verdad), no solo una preferencia guardada. `externalDbEngine`: "MONGODB" |
  /// "GRAPH_NEO4J" | `null` (sin conexión externa configurada para este cliente).
  externalDbEngine        String?
  externalDbConnectionUri String?
  externalDbUsername      String?
  externalDbPasswordEnc   String?
  externalDbDatabaseName  String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  environments ApiEnvironment[]

  @@map("clients")
}

model ApiEnvironment {
  id              String  @id @default(uuid())
  name            String
  description     String?
  /// EnvironmentType: UATHA | QA | PRODUCTION
  environmentType String
  baseUrl         String
  active          Boolean @default(true)
  timeoutMs       Int     @default(15000)
  maxRetries      Int     @default(2)

  // Secretos cifrados (AES-256-GCM vía CredentialEncryptionService). Nunca texto plano.
  basicAuthUsernameEnc         String?
  basicAuthPasswordEnc         String?
  apiUsernameEnc               String?
  apiPasswordEnc               String?
  webhookUsernameEnc           String?
  webhookPasswordEnc           String?
  credentialsEncryptionVersion Int     @default(1)

  grantType                 String  @default("password")
  passwordIsPreHashed       Boolean @default(false)
  tokenRefreshMarginSeconds Int     @default(60)

  authTokenEndpoint           String  @default("/authorization-server/oauth/token")
  createValidationEndpoint    String  @default("/biometrics-by-steps/validations")
  saveValidationStepEndpoint  String  @default("/validation/saveValidationStep/{validationId}")
  getValidationStepEndpoint   String  @default("/validation/getValidationStep/{validationId}")
  /// ConfigurableHttpMethod: GET | POST
  getValidationStepHttpMethod String  @default("GET")
  getValidationDataEndpoint   String  @default("/validation/validations/getValidationData/{validationId}")
  launchUrlTemplate           String?

  webhookUrl    String?
  webhookActive Boolean @default(false)

  /// Clave de API para que un SISTEMA EXTERNO (no un operador de esta consola, no el cliente
  /// final) cree por su cuenta una nueva validación Web SDK y reciba el enlace de captura — ver
  /// `external-api-key.service.ts`. Solo se guarda el hash SHA-256 (mismo patrón que
  /// `PasswordResetToken.tokenHash`): la clave real solo se muestra UNA vez, al generarla/rotarla,
  /// nunca se puede recuperar después. `externalApiKeyPrefix` (primeros caracteres, no secretos)
  /// es solo para que el operador identifique la clave activa en la interfaz.
  externalApiKeyHash        String?   @unique
  externalApiKeyPrefix      String?
  externalApiKeyCreatedAt   DateTime?
  externalApiKeyLastUsedAt  DateTime?

  /// ConnectionStatus: NOT_CONFIGURED | UNKNOWN | OK | FAILED
  connectionStatus String    @default("NOT_CONFIGURED")
  lastTestedAt     DateTime?

  /// IntegrationModel: API_BY_STEPS | WEB_SDK (ver docs/technical-analysis.md — "Selección del
  /// Modelo de Integración"). API_BY_STEPS es el modelo original (FAD aloja el proceso, esta
  /// consola solo lo configura/monitorea). WEB_SDK habilita el flujo de captura embebida
  /// (Acuant + Facetec vía @fad-producto/fad-sdk) documentado en `webSdkConfig`.
  integrationModel String @default("API_BY_STEPS")

  /// `null` = ambiente de plataforma (histórico, visible solo para usuarios de plataforma). Con
  /// un cliente asignado, el ambiente (y sus credenciales/ejecuciones) queda dentro del subárbol
  /// de ese cliente — ver `clientId` en `User`.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates       ValidationTemplate[]
  executions      ValidationExecution[]
  webSdkConfig    WebSdkConfig?
  webSdkTemplates WebSdkTemplate[]
  shareLinks      WebSdkShareLink[]
  naatCheckConfig NaatCheckConfig?

  @@map("api_environments")
}

/// Configuración de NAAT-CHECK (NAAT.TECH "API RECHECK PROCESS") por ambiente — un servicio
/// EXTERNO a FAD (proveedor propio, servidor OAuth propio) que reevalúa el riesgo de un documento
/// ya capturado bajo pedido (botón "Reevaluar con NAAT-CHECK" en el detalle de una ejecución).
/// Distinto de `naatCheckResult` en el detalle normalizado (pasivo, lo devuelve FAD cuando
/// `steps.captureId.configuration.idValidations.naatCheck.enabled` está activo) y del NAAT-CHECK
/// del flujo Web SDK (`WebSdkConfig.checkEndpoint`, orquestado dentro de esa misma ejecución) —
/// ver `apps/backend/src/modules/naat-check/`. `webhookUsernameEnc`/`webhookPasswordEnc` son las
/// credenciales que EXPONEMOS para que NAAT-CHECK llame de vuelta a nuestro webhook (Basic Auth,
/// mismo patrón que `ApiEnvironment.webhookUsernameEnc`).
model NaatCheckConfig {
  id            String         @id @default(uuid())
  environmentId String         @unique
  environment   ApiEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)
  baseUrl String  @default("https://uat.firmaautografa.com")

  usernameEnc String?
  passwordEnc String?

  /// RiskLevel (LOW | MEDIUM | HIGH) — el nivel de riesgo máximo que se considera "aceptado". Un
  /// resultado con un riesgo mayor a este se marca como fallo en el reporte/puntuación.
  acceptedRiskLevel String @default("LOW")

  webhookUsernameEnc String?
  webhookPasswordEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("naat_check_configs")
}

/// Configuración del modelo de integración "Web SDK": captura de documento (Acuant) y prueba de
/// vida (Facetec) ejecutadas en el navegador del cliente vía @fad-producto/fad-sdk (iframe),
/// mientras que la autenticación OAuth, NAAT-CHECK, compareFacesPassive y saveValidationData
/// (empaquetado .TAR + cifrado AES-256-CBC) se orquestan en nuestro backend — nunca se envían al
/// navegador el client_secret OAuth, el password del usuario API, ni la llave/vector AES.
/// Ver docs/websdk-integration.md.
model WebSdkConfig {
  id            String         @id @default(uuid())
  environmentId String         @unique
  environment   ApiEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  // SDK (iframe) — no son las credenciales OAuth de la API, son propias del "Token generation".
  sdkBaseUrl   String  @default("https://uathaapiframe.firmaautografa.com")
  sdkRequestId String?
  sdkTokenEnc  String? // opcional: si falta, se usa el access_token OAuth como fallback

  /// DocumentCaptureEngine: ACUANT | REGULA | CAPTURE_ID — ver docs/websdk-integration.md.
  documentCaptureEngine          String  @default("ACUANT")
  acuantPassiveUsernameEnc       String?
  acuantPassivePasswordEnc       String?
  acuantPassiveSubscriptionIdEnc String?
  acuantAcasEndpoint             String  @default("https://eu.acas.acuant.net")
  acuantLivenessEndpoint         String  @default("https://eu.passlive.acuant.net")
  acuantAssureidEndpoint         String  @default("https://eu.assureid.acuant.net")
  /// JSON serializado: { idData, idPhoto, manualCapture }
  acuantParams                   String  @default("{\"idData\":true,\"idPhoto\":true,\"manualCapture\":false}")
  /// JSON serializado: objeto CONFIGURATION de startAcuant (no contiene secretos)
  acuantConfiguration            String  @default("{}")

  /// Licencia de Regula en Base64 (ver "FAD SDK Web Regula" §Credentials), cifrada.
  regulaLicenseEnc    String?
  /// URL interna del proveedor Regula ("apiBasePath must always be an internal URL").
  regulaApiBasePath   String?
  /// RegulaCaptureType: DOCUMENT_READER | CAMERA_SNAPSHOT | DESKTOP
  regulaCaptureType   String  @default("CAMERA_SNAPSHOT")
  /// JSON serializado: { idData, idPhoto }
  regulaParams        String  @default("{\"idData\":true,\"idPhoto\":true}")
  /// JSON serializado: objeto CONFIGURATION de startRegula (no contiene secretos)
  regulaConfiguration String  @default("{}")

  /// startCaptureId(configuration) no recibe credenciales por parámetro: se autentica con
  /// sdkTokenEnc (arriba). JSON serializado: { idPhoto, originalPhoto }
  captureIdParams        String @default("{\"idPhoto\":true,\"originalPhoto\":false}")
  /// JSON serializado: objeto CONFIGURATION de startCaptureId (no contiene secretos)
  captureIdConfiguration String @default("{}")

  /// BiometricEngine: FACETEC (único soportado)
  biometricEngine                       String  @default("FACETEC")
  facetecUseMiddleware                  Boolean @default(true)
  /// JSON serializado: descriptor del middleware FAD (module/provider/platform/app/version/...)
  facetecMiddleware                     String  @default("{}")
  facetecDeviceKeyIdentifierEnc         String?
  facetecPublicFaceScanEncryptionKeyEnc String?
  /// JSON cifrado: { domains, expiryDate, key } (productionKeyText)
  facetecProductionKeyTextEnc           String?
  /// JSON serializado: objeto CONFIGURATION de startFacetec (no contiene secretos)
  facetecConfiguration                  String  @default("{}")

  checkEndpoint              String @default("/naat-check-api/idholo/multiple")
  compareFacesEndpoint       String @default("/biometrics/compareFacesPassive")
  getValidationKeysEndpoint  String @default("/validation/validations/getValidationKeys")
  saveValidationDataEndpoint String @default("/validation/validations/saveValidationData")

  checkMaxAttempts       Int    @default(3)
  /// RiskLevel aceptado para continuar: LOW | MEDIUM | HIGH
  checkAcceptedRisk      String @default("LOW")
  faceMatchMinConfidence Float  @default(85)

  /// JSON serializado: copy configurable del front de onboarding (ver
  /// WebSdkOnboardingMessagesSchema) — nunca contiene secretos, solo textos de cara al cliente.
  onboardingMessages String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("web_sdk_configs")
}

/// Plantilla reutilizable para el modelo de integración Web SDK — el equivalente de
/// ValidationTemplate para API_BY_STEPS, pero con su propia forma: por-pasos guarda un
/// `ValidationRequestConfig` completo (qué pasos van, en qué orden, con qué configuración) porque
/// eso es lo que arma la petición a FAD; Web SDK ya tiene ESO fijo por ambiente (motor de
/// documento, credenciales — ver WebSdkConfig), así que una plantilla aquí solo cubre lo que
/// puede variar por proceso sin tocar credenciales: los textos de cada pantalla, el tema/colores
/// de marca, y los umbrales de intentos/riesgo/confianza. Un `null` en cualquiera de esos campos
/// significa "usa lo que ya tenga el ambiente" — nunca se fabrica un valor.
model WebSdkTemplate {
  id            String         @id @default(uuid())
  name          String
  description   String?
  environmentId String
  environment   ApiEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  active        Boolean        @default(true)

  /// JSON serializado: subconjunto de WebSdkOnboardingMessagesSchema (solo los campos que esta
  /// plantilla sobreescribe) — se combina en tiempo de ejecución como DEFAULT < ambiente <
  /// plantilla (ver `resolveEffectiveSettings` en websdk-template.service.ts).
  onboardingMessages String?

  /// JSON serializado: FadCustomization (colors/buttons/fonts, misma forma que ya usan los 4
  /// módulos del Web SDK vía `configuration.customization.fadCustomization`) — cuando no es
  /// null/vacío, REEMPLAZA por completo el tema del ambiente para esta plantilla (no se mezcla
  /// campo a campo, para no dejar una combinación de colores a medias sin que el operador la vea
  /// completa en la vista previa).
  customization String?

  checkMaxAttempts       Int?
  /// RiskLevel: LOW | MEDIUM | HIGH — null = usa el del ambiente.
  checkAcceptedRisk      String?
  faceMatchMinConfidence Float?

  createdById String?
  createdBy   User?   @relation("WebSdkTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("WebSdkTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions ValidationExecution[]
  shareLinks WebSdkShareLink[]

  @@map("web_sdk_templates")
}

model ProviderCatalogEntry {
  id                 String   @id @default(uuid())
  providerKey        String   @unique
  providerLabel      String
  providerType       String
  externalProviderId Int
  enabled            Boolean  @default(true)
  /// JSON serializado (Record<string, unknown>)
  metadata           String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("provider_catalog_entries")
}

model ValidationTemplate {
  id            String          @id @default(uuid())
  name          String
  description   String?
  version       Int             @default(1)
  environmentId String?
  environment   ApiEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  /// JSON serializado (ValidationRequestConfig)
  requestConfig String
  active        Boolean         @default(true)

  createdById String?
  createdBy   User?   @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("TemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions    ValidationExecution[]
  responseViews ResponseView[]

  @@map("validation_templates")
}

model ResponseView {
  id            String              @id @default(uuid())
  name          String
  description   String?
  /// ResponseViewKind: EXECUTIVE | OPERATIVE | TECHNICAL | CUSTOM
  kind          String              @default("CUSTOM")
  /// JSON serializado (ResponseViewConfig)
  configuration String
  templateId    String?
  template      ValidationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  isDefault     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("response_views")
}

model ValidationExecution {
  id           String  @id @default(uuid())
  validationId String?
  processName  String

  environmentId String
  environment   ApiEnvironment      @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  templateId    String?
  template      ValidationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Plantilla Web SDK aplicada (textos/tema/umbrales) — distinta de `templateId` (que apunta a
  /// ValidationTemplate, el modelo de by-steps): un mismo `templateId` no sirve para ambas porque
  /// cada una tiene su propia forma de configuración. `null` en ejecuciones API_BY_STEPS y en las
  /// Web SDK que no usaron ninguna plantilla (quedan con la configuración del ambiente).
  webSdkTemplateId String?
  webSdkTemplate   WebSdkTemplate? @relation(fields: [webSdkTemplateId], references: [id], onDelete: SetNull)

  /// JSON serializado: cuerpo enviado a FAD
  requestPayload     String
  /// JSON serializado: respuesta cruda de FAD (createValidation)
  responsePayload    String?
  /// JSON serializado: última respuesta normalizada (estado/detalle)
  normalizedResponse String?

  rawStatus        String?
  /// NormalizedValidationStatus
  normalizedStatus String  @default("CREATED")
  result           String?

  clientNameMasked  String
  clientEmailMasked String

  keyEncrypted    String?
  vectorEncrypted String?

  /// JSON serializado: estado transitorio del flujo Web SDK mientras se ejecuta (resultado de
  /// Acuant/Facetec, intentos de NAAT-CHECK, resultado de compareFacesPassive). Se limpia una vez
  /// completado (ver módulo `websdk`). Null en ejecuciones API_BY_STEPS.
  webSdkState String?

  isDemo Boolean @default(false)

  startedAt    DateTime?
  completedAt  DateTime?
  lastSyncedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ExecutionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps         ValidationStepExecution[]
  webhookEvents WebhookEvent[]
  shareLink     WebSdkShareLink?

  @@index([validationId])
  @@index([normalizedStatus])
  @@map("validation_executions")
}

model ValidationStepExecution {
  id                    String              @id @default(uuid())
  validationExecutionId String
  validationExecution   ValidationExecution @relation(fields: [validationExecutionId], references: [id], onDelete: Cascade)

  stepKey        String
  externalStepId String?
  order          Int
  show           Boolean @default(true)
  /// NormalizedStepStatus
  status         String  @default("PENDING")
  /// JSON serializado
  configuration  String?
  /// JSON serializado
  features       String?
  /// JSON serializado
  input          String?
  /// JSON serializado
  data           String?

  startedAt   DateTime?
  completedAt DateTime?

  @@unique([validationExecutionId, stepKey])
  @@map("validation_step_executions")
}

model WebhookEvent {
  id              String  @id @default(uuid())
  externalEventId String
  idOriginal      String?
  idUser          String?
  eventType       String
  validationId    String?

  validationExecutionId String?
  validationExecution   ValidationExecution? @relation(fields: [validationExecutionId], references: [id], onDelete: SetNull)

  creationDateRaw String?
  receivedAt      DateTime @default(now())
  retry           Int      @default(0)
  error           String?
  /// JSON serializado: envelope completo recibido
  payload         String

  /// WebhookProcessingStatus
  processingStatus String    @default("RECEIVED")
  processedAt      DateTime?
  processingError  String?

  uniqueHash String @unique

  @@index([eventType])
  @@index([validationId])
  @@map("webhook_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// AuditAction
  action     String
  entityType String?
  entityId   String?
  /// JSON serializado, sin secretos
  metadata   String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       String?
  encrypted   Boolean  @default(false)
  description String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

/// Enlace de captura Web SDK compartible (QR / correo / WhatsApp / copiar enlace): permite que un
/// operador o el rol LAUNCHER "envíe" un proceso de validación a un cliente final, quien lo abre
/// en su propio teléfono SIN necesitar una sesión de esta consola (ver
/// apps/backend/src/modules/websdk/websdk-share.routes.ts, rutas públicas montadas fuera de
/// `requireAuth`). El `token` es la única credencial: opaco, de un solo uso, con expiración corta.
/// Nunca se reutiliza el mismo modelo para el modelo API_BY_STEPS (ese usa `launchUrlTemplate`,
/// que ya es público por diseño de FAD).
model WebSdkShareLink {
  id            String         @id @default(uuid())
  token         String         @unique
  environmentId String
  environment   ApiEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  templateId    String?
  /// Plantilla Web SDK a aplicar (textos/tema/umbrales) al iniciar la captura — ver
  /// `webSdkTemplateId` en ValidationExecution para la distinción frente a `templateId`.
  webSdkTemplateId String?
  webSdkTemplate   WebSdkTemplate? @relation(fields: [webSdkTemplateId], references: [id], onDelete: SetNull)
  processName      String?

  /// JSON serializado: { name, mail, phone } — mismo shape que WebSdkStartInput.client
  client String

  /// WebSdkShareLinkStatus: PENDING (creado, no abierto) | STARTED (el cliente lo abrió y ya
  /// arrancó la ejecución) | COMPLETED (la ejecución terminó) | EXPIRED
  status String @default("PENDING")

  executionId String?              @unique
  execution   ValidationExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  /// `null` = creado por un sistema externo vía la clave de API del ambiente (ver
  /// `externalApiKeyHash` en ApiEnvironment / `websdk-external.routes.ts`), no por un operador con
  /// sesión en esta consola.
  createdById String?
  createdBy   User?   @relation("ShareLinkCreatedBy", fields: [createdById], references: [id])

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("web_sdk_share_links")
}

/// Configuración global (no por ambiente) de mensajería saliente para enviar el enlace de
/// captura Web SDK por correo (SMTP) o WhatsApp (WhatsApp Cloud API de Meta). Fila única
/// (id = "singleton"). Nunca se fabrica una confirmación de envío: `email.service.ts` /
/// `whatsapp.service.ts` devuelven exactamente lo que el proveedor respondió.
model MessagingConfig {
  id String @id @default("singleton")

  smtpHost        String?
  smtpPort        Int     @default(587)
  smtpSecure      Boolean @default(false)
  smtpUserEnc     String?
  smtpPasswordEnc String?
  fromAddress     String?
  fromName        String  @default("Biometric Console")

  whatsappApiBaseUrl       String  @default("https://graph.facebook.com/v20.0")
  whatsappPhoneNumberId    String?
  whatsappAccessTokenEnc   String?
  whatsappTemplateName     String?
  whatsappTemplateLanguage String  @default("es")

  updatedAt DateTime @updatedAt

  @@map("messaging_config")
}

/// Configuración global (no por ambiente) para puntuar `documentChecks` (Validación de ID del
/// paso `captureId`): peso relativo por categoría (`categoryWeights`, JSON `Record<categoría,
/// número>` — una categoría ausente pesa 1 por defecto) y un umbral de aprobación opcional
/// (`passThreshold`, 0-100; `null` = sin umbral configurado, el reporte solo muestra el
/// porcentaje sin veredicto). Fila única (id = "singleton"). El peso y el umbral son una decisión
/// de negocio del operador, nunca algo que FAD indique — por eso son configurables en vez de
/// estar codificados.
model DocumentCheckScoringConfig {
  id String @id @default("singleton")

  categoryWeights       String  @default("{}")
  /// JSON serializado: Record<category, Record<featureName, subpeso 1-100>> — ver
  /// `DocumentCheckScoringConfigDto.featureWeights` en shared-types.
  featureWeights        String  @default("{}")
  passThreshold         Int?
  treatNotDoneAsFailure Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("document_check_scoring_config")
}

/// Motor de base de datos elegido y datos de conexión de referencia (pestaña "Base de datos" del
/// menú) — fila única (id = "singleton"), igual patrón que MessagingConfig. IMPORTANTE: guardar
/// esta configuración NO cambia en caliente la base de datos que esta instancia usa — Prisma fija
/// el motor (`datasource.provider`) al generar el cliente, así que cambiar de motor siempre
/// requiere: 1) actualizar `DATABASE_URL` con la cadena de conexión real, 2) usar el esquema
/// correspondiente (`prisma/postgresql/schema.prisma` para Postgres — ver
/// `scripts/build-postgresql-schema.mjs`), 3) `prisma migrate deploy`, 4) reiniciar el servidor.
/// Esta fila sirve para: a) documentar/recordar el motor objetivo y sus datos de conexión, y b)
/// permitir "Probar conexión" antes de aplicar el cambio real. MongoDB y grafos (Neo4j) se pueden
/// seleccionar y guardar como preferencia, pero no tienen soporte funcional todavía (requieren un
/// modelo de datos y capa de acceso distintos a Prisma+SQL) — ver DatabaseEngine en shared-types.
model DatabaseConnectionConfig {
  id String @id @default("singleton")

  engine String @default("SQLITE")

  host          String?
  port          Int?
  databaseName  String?
  username      String?
  passwordEnc   String?
  ssl           Boolean @default(true)
  /// URI completa (p. ej. `bolt://host:7687`) para motores que no usan host/puerto separados,
  /// como Neo4j.
  connectionUri String?

  updatedAt DateTime @updatedAt

  @@map("database_connection_config")
}
